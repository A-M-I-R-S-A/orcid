{
  "name": "orchid",
  "version": "0.1.0",
  "private": true,
  "description": "Orchid / ارکید — Persian RTL lingerie storefront",
  "engines": {
    "node": ">=22.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:content": "node scripts/audit-public-content.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare:logo": "node scripts/prepare-logo.mjs",
    "mock:images": "tsx --conditions=react-server scripts/mock-images.ts",
    "dev:otp": "node --env-file=.env scripts/dev-otp.mjs",
    "dev:account": "node --env-file=.env scripts/dev-account.mjs",
    "demo:orders": "tsx --conditions=react-server scripts/demo-orders.ts",
    "test:integration": "node --env-file=.env scripts/test-integration.mjs",
    "db:restore-drill": "node --env-file=.env scripts/restore-drill.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "isomorphic-dompurify": "^2.19.0",
    "mysql2": "^3.12.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
