# ─────────────────────────────────────────────────────────────────────────────
# Orchid — environment template
# Copy to .env and fill in. NEVER commit .env. On the host, chmod 600.
# ─────────────────────────────────────────────────────────────────────────────

# Database ────────────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=orchid
DB_USER=orchid
DB_PASSWORD=

# Connections opened PER NODE WORKER. Managed hosts run several workers and
# multiply this. Keep it small and confirm the host's max_user_connections
# before raising it. Planning package §L.
DB_POOL_SIZE=4

# Application ─────────────────────────────────────────────────────────────────
# Canonical origin. Every canonical URL, sitemap entry and OG tag derives from
# this. No trailing slash.
APP_URL=https://orchidbra.ir
NODE_ENV=production
TZ=Asia/Tehran
PORT=3000

# Secrets ─────────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Keys the double-submit CSRF token for route handlers (lib/crypto.ts
# signCsrfToken). Server Actions get their CSRF protection from Next's own
# origin check, so this covers the mutating route handlers only.
#
# NOT a session-signing key, despite the name. Sessions are opaque random
# tokens stored HASHED in `sessions` / `admin_sessions` and looked up per
# request, so they are server-side revocable and carry no signature. Rotating
# this invalidates in-flight CSRF tokens (a re-submitted form fails once); it
# does NOT sign anyone out.
SESSION_SECRET=

# AUTH_SECRET was removed. It was documented here as signing admin session
# tokens, and no code has ever read it — admin sessions are opaque hashed
# tokens in `admin_sessions`, exactly like customer ones. An unused secret in
# a deployment template is worse than no entry: it gets generated, backed up
# and rotated as though something depended on it. Nothing does.

# Peppers OTP hashes. Rotating this only invalidates in-flight codes.
OTP_PEPPER=

# AES-256-GCM master key for provider credentials stored in the settings table
# (SMS.ir, TorobPay, BitPay). Must be exactly 64 hex characters (32 bytes).
#
# WARNING: back this up SEPARATELY from your database dumps. Losing it means
# re-entering every integration credential; storing it beside the dump defeats
# the point of encrypting them.
ENCRYPTION_KEY=

# Bearer token guarding /api/cron/* (SMS dispatch, unpaid-order expiry, backups).
CRON_SECRET=

# Storage ─────────────────────────────────────────────────────────────────────
# Absolute path OUTSIDE the deploy directory. If this lives inside the release
# folder, every product image is destroyed on the next deploy. Planning §N-2.
#   host example:  /home/USER/orchid-storage
#   local example: C:/Users/you/orchid-storage
#
# ABSOLUTE IS NOT ADVICE HERE — a relative path is resolved against the
# process's working directory, and Next's standalone entrypoint opens with
# `process.chdir(__dirname)`. So `./storage` means `.next/standalone/storage`
# in production: media 404s even when the files exist, and anything uploaded
# lands inside the release directory that the next deploy replaces. Both were
# observed on this project with the previous default of `./storage`.
UPLOAD_DIR=/home/USER/orchid-storage

# Gzipped database dumps (§M). Defaults to <UPLOAD_DIR>/backups; 14 kept, one
# per day, written by the cron route. Restore procedure: docs/RESTORE.md.
# BACKUP_DIR=/home/USER/orchid-storage/backups

# Rotating application log (§82). Defaults to <UPLOAD_DIR>/logs, which is
# already outside the deploy directory — the property that matters, since the
# log you most want after a bad release is the one a rollback would delete.
# Set it only to put logs somewhere other than beside the uploads.
# LOG_DIR=/home/USER/orchid-storage/logs

# ─────────────────────────────────────────────────────────────────────────────
# NOT HERE ON PURPOSE
#
# SMS.ir credentials, TorobPay Client ID / Client Secret / username / password,
# and the BitPay API key are administrator-managed. Secrets are encrypted in the
# `settings` table and can be rotated from the admin panel without a redeploy.
# Only ENCRYPTION_KEY lives here.
# Planning package §D-4 / §F.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local development ────────────────────────────────────────────────────────
# `null` swaps SMS.ir for a provider that records what it WOULD have sent, so
# registration, OTP sign-in and password reset all work without credentials.
# The code is still never logged (§24) — recover it from the database with:
#   NODE_ENV=development node --env-file=.env scripts/dev-otp.mjs 09121234567
# COMMENTED OUT ON PURPOSE — uncomment only on a development machine.
#
# With this set, every message is accepted by a no-op provider and marked
# "sent" in the admin queue. That is exactly right locally and catastrophic on
# a host: OTP is a way into an account, so a shop that silently swallows it has
# no working registration and a panel that reports success. The application
# refuses to boot with this set unless APP_URL is localhost (lib/env-guard),
# because a comment is not a safeguard — the previous default of
# `UPLOAD_DIR=./storage` shipped under a comment saying it had to be absolute.
# SMS_DRIVER=null
